{
  "name": "demand-check",
  "version": "0.1.0",
  "description": "Check real demand for an app or package idea before you build it: top apps, installs, low-star complaints, npm downloads and a verdict.",
  "type": "module",
  "bin": {
    "demand-check": "./bin/demand-check.js"
  },
  "files": [
    "bin",
    "src",
    "skills",
    ".claude-plugin",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18.17"
  },
  "scripts": {
    "test": "node --test 'test/*.test.js'",
    "start": "node bin/demand-check.js"
  },
  "keywords": [
    "app-ideas",
    "market-research",
    "play-store",
    "app-store",
    "npm",
    "reviews",
    "validation",
    "cli",
    "claude-code",
    "skill"
  ],
  "author": "Deepak Sharma (https://github.com/dasjideepak)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dasjideepak/demand-check.git"
  },
  "homepage": "https://github.com/dasjideepak/demand-check#readme",
  "bugs": {
    "url": "https://github.com/dasjideepak/demand-check/issues"
  },
  "dependencies": {
    "google-play-scraper": "^10.1.3"
  }
}
